# Supabase project (Project Settings -> API)
NEXT_PUBLIC_SUPABASE_URL=your_supabase_url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key
# Server-only. Used to write GitHub-verified skills and by the invite-expiry cron.
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key

# Public URL of the deployed app, used to build the OAuth redirect (e.g. https://matchmaker.vercel.app)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Shared secret Vercel Cron sends as "Authorization: Bearer <CRON_SECRET>"
CRON_SECRET=generate_a_long_random_string

# Optional: a GitHub token with no scopes. Raises the public-API rate limit used for manual re-syncs.
GITHUB_TOKEN=

# Admin GitHub usernames (comma-separated). Authorized to create/manage hackathons in-app.
ADMIN_GITHUB_USERNAMES=meyyarasan65-dot
